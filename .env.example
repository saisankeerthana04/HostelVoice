# HostelVoice — required environment variables
# Copy this file to ".env" and fill in your own key.
# NEVER commit your real .env file or paste a real key here.

# Sarvam AI API key (from https://dashboard.sarvam.ai)
# Used for Speech-to-Text (saarika) and the chat LLM (sarvam-m).
# If left empty, the app runs in DEMO MODE with a sample complaint.
SARVAM_API_KEY=

# Optional overrides — safe defaults are used if omitted.
# SARVAM_STT_MODEL=saarika:v2
# SARVAM_CHAT_MODEL=sarvam-m

# Optional: port for the Flask server (default 5000)
# PORT=5000
